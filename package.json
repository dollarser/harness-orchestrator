{
  "name": "@dollarser/dsh-smart-dev",
  "version": "0.2.0",
  "description": "Deterministic coding orchestration as a DeepSeek Harness plugin",
  "type": "module",
  "license": "MIT",
  "repository": "github:dollarser/harness-orchestrator",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/dsh/plugin.d.ts",
      "import": "./dist/dsh/plugin.js"
    }
  },
  "main": "dist/dsh/plugin.js",
  "types": "dist/dsh/plugin.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "docs/usage.md",
    "docs/architecture.md",
    "docs/validation.md",
    "docs/decisions",
    "legacy/python/README.md",
    "scripts/create-overlay.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-docs.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
