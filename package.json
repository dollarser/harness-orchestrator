{
  "name": "@dollarser/dsh-smart-dev",
  "version": "0.11.0",
  "description": "Native DSH multi-agent setup, diagnostics and optional delegation guidance",
  "type": "module",
  "license": "MIT",
  "repository": "github:dollarser/harness-orchestrator",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/dsh/plugin.d.ts",
      "import": "./dist/dsh/plugin.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "main": "dist/dsh/plugin.js",
  "types": "dist/dsh/plugin.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts/create-overlay.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-docs.mjs",
    "prepack": "npm run build",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@playwright/test": "1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
